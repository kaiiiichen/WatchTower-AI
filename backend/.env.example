# Copy to .env and fill in the keys you have. Missing keys -> that provider
# is reported as "unknown" (no crash).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models are DISCOVERED dynamically at startup (flagship + mid per provider).
# The values below are only fallbacks used if discovery fails / no key.
# ANTHROPIC_MODEL=claude-opus-4-1
# ANTHROPIC_MODEL_MID=claude-sonnet-4-5
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL_MID=gpt-4o-mini
# GEMINI_MODEL=gemini-1.5-pro
# GEMINI_MODEL_MID=gemini-1.5-flash

# Community signals use the public HN Algolia Search API — no credentials needed.
# Optional overrides:
# COMMUNITY_INTERVAL=60
# COMMUNITY_LOOKBACK_HOURS=24
# HN_ALGOLIA_BASE=https://hn.algolia.com/api/v1

# Downdetector corroboration via Browserbase (OFF by default — demo flag).
# DOWNDETECTOR_ENABLED=0
# BROWSERBASE_API_KEY=
# BROWSERBASE_SESSIONS_URL=https://api.browserbase.com/v1/sessions
# DOWNDETECTOR_WAIT_TIMEOUT_MS=40000
# DOWNDETECTOR_RECENT_HOURS=24
# DOWNDETECTOR_MIN_COMMENTS=5
# DOWNDETECTOR_SUMMARY_MODEL=claude-3-5-haiku-latest

# Demo-only: force a provider's probe status to degraded (OFF by default).
# Triggers incident alerts + live Downdetector fetch for that provider.
# Real probes and community fetches still run. Valid: Claude | GPT | Gemini
# DEMO_FORCE_DOWN=GPT

# Other overrides
# PROBE_INTERVAL=30
# CORS_ORIGINS=http://localhost:3000

# Gemini official status (headless browser — see app/gemini_status_browser.py)
# GEMINI_STATUS_BROWSER=1
# GEMINI_STATUS_BROWSER_TIMEOUT=30

# Sentry (optional). Unset -> Sentry disabled (no-op). Get DSN from your Sentry project.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=watchtower
# SENTRY_TRACES_SAMPLE_RATE=1.0
