# Copy to .env at the repo root, then: docker compose up --build
#
# Provider API keys (missing key -> that provider reports "unknown", no crash)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Downdetector corroboration via Browserbase (remote CDP — no local browsers in the image)
DOWNDETECTOR_ENABLED=0
BROWSERBASE_API_KEY=
DOWNDETECTOR_SUMMARY_MODEL=claude-3-5-haiku-latest

# Sentry (optional — unset disables error reporting)
SENTRY_DSN=

# Frontend -> backend (set automatically in docker-compose.yml; override only if needed)
# BACKEND_URL=http://backend:8000
